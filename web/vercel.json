{
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm install --include=dev && npm run build",
  "rewrites": [
    { "source": "/job/:id", "destination": "/index.html" },
    { "source": "/companies", "destination": "/index.html" },
    { "source": "/companies/:name", "destination": "/index.html" },
